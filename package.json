{
  "name": "mb-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w mb-backoffice",
    "dev:backoffice": "npm run dev -w mb-backoffice",
    "dev:shop": "npm run dev -w mb-shop",
    "build": "npm run build -w mb-backoffice && npm run build -w mb-shop",
    "build:backoffice": "npm run build -w mb-backoffice",
    "build:shop": "npm run build -w mb-shop",
    "start": "npm run start -w mb-backoffice",
    "start:backoffice": "npm run start -w mb-backoffice",
    "start:shop": "npm run start -w mb-shop",
    "test": "npm run test -w mb-backoffice",
    "deps:update": "npm run deps:update -w mb-backoffice"
  },
  "engines": {
    "node": ">=24"
  }
}